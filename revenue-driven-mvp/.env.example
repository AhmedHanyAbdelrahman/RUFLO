# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (OpenAI or Anthropic — abstraction picks based on AI_PROVIDER)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx
AI_MODEL=claude-sonnet-5

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxx
TWILIO_FROM_NUMBER=+15555550100

# Email (SendGrid or Postmark — abstraction picks based on EMAIL_PROVIDER)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxx
POSTMARK_API_KEY=xxxx
EMAIL_FROM=recovery@yourshop.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_FOUND_MONEY_SPRINT=price_xxxx
STRIPE_PRICE_REACTIVATE_LITE=price_xxxx
STRIPE_PRICE_REACTIVATE_GROWTH=price_xxxx
STRIPE_PRICE_REVENUE_DRIVEN_OS=price_xxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-local-dev-secret
